# Gere um segredo diferente por ambiente: openssl rand -base64 32
JWT_SECRET=gere-um-segredo-base64-com-pelo-menos-32-bytes

# Banco PostgreSQL usado pelo docker compose
POSTGRES_DB=servicehub
POSTGRES_USER=servicehub
POSTGRES_PASSWORD=altere-esta-senha-local

# URL embutida no bundle do frontend durante o build
VITE_API_URL=http://localhost:8081/api
